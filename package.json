{
  "name": "newma-desktop",
  "version": "1.0.0",
  "description": "Newma Desktop - Cross-platform AI chat application with local Gateway integration",
  "main": "dist/main/index.js",
  "author": "Newma Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "npm run build:main && electron .",
    "build": "npm run build:main && npm run build:preload",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:web": "node scripts/build-web.js",
    "build:gateway": "node scripts/build-gateway.js",
    "watch": "tsc -p tsconfig.main.json --watch",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:mac:arm": "npm run build && electron-builder --mac --arm64",
    "dist:mac:intel": "npm run build && electron-builder --mac --x64",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "postinstall": "npm run build:gateway"
  },
  "build": {
    "appId": "com.newma.desktop",
    "productName": "Newma Desktop",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "gateway-source/dist/**/*",
      "gateway-source/node_modules/**/*",
      "node_modules/newma-cli/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "gateway-source",
        "to": "gateway-source",
        "filter": [
          "**/*",
          "!node_modules/@types/**"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "resources/icons/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "resources/icons/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "resources/icons/icon.png",
      "category": "Chat"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "tree-kill": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "electron": "^28.3.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3"
  }
}
